generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tournament {
  id                 String         @id @default(cuid())
  name               String         @default("AMRELI 1st HOCKEY 7-SIDE TOURNAMENT")
  description        String?
  logo               String?
  banner             String?
  location           String         @default("Amreli, Gujarat, India")
  venue              String         @default("Amreli District Sports Complex Ground")
  startDate          DateTime       @default(now())
  endDate            DateTime       @default(now())
  status             String         @default("LIVE")
  sport              String         @default("Field Hockey — 7-Side")
  format             String         @default("LEAGUE_KNOCKOUT")
  currentStage       String         @default("LEAGUE")
  qualificationCount Int            @default(4)
  pointsForWin       Int            @default(3)
  pointsForDraw      Int            @default(1)
  pointsForLoss      Int            @default(0)
  tieBreakerRules    String         @default("Points > Goal Difference > Goals For > Head-to-Head")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  announcements      Announcement[]
  matches            Match[]
  teams              Team[]
}

model Team {
  id           String       @id @default(cuid())
  tournamentId String
  name         String
  shortName    String
  logo         String?
  captainId    String?
  coach        String?
  description  String?
  primaryColor String       @default("#059669")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  awayMatches  Match[]      @relation("TeamB")
  homeMatches  Match[]      @relation("TeamA")
  matchEvents  MatchEvent[]
  players      Player[]
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Player {
  id           String       @id @default(cuid())
  teamId       String
  name         String
  jerseyNumber Int
  position     String
  photo        String?
  status       String       @default("ACTIVE")
  isCaptain    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  matchEvents  MatchEvent[]
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Match {
  id           String         @id @default(cuid())
  tournamentId String
  round        String         @default("LEAGUE")
  matchNumber  Int
  teamAId      String?
  teamBId      String?
  teamAScore   Int            @default(0)
  teamBScore   Int            @default(0)
  date         DateTime       @default(now())
  time         String         @default("17:30")
  venue        String         @default("Pitch 1")
  status       String         @default("UPCOMING")
  notes        String?
  winnerId     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  knockout     KnockoutMatch?
  teamB        Team?          @relation("TeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  teamA        Team?          @relation("TeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  events       MatchEvent[]
}

model MatchEvent {
  id        String   @id @default(cuid())
  matchId   String
  teamId    String
  playerId  String?
  type      String
  minute    Int
  notes     String?
  createdAt DateTime @default(now())
  player    Player?  @relation(fields: [playerId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model KnockoutMatch {
  id                  String   @id @default(cuid())
  stage               String
  matchId             String   @unique
  bracketOrder        Int
  seedLabelA          String?
  seedLabelB          String?
  nextKnockoutMatchId String?
  createdAt           DateTime @default(now())
  match               Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model Announcement {
  id           String     @id @default(cuid())
  tournamentId String
  title        String
  message      String
  type         String     @default("GENERAL")
  priority     String     @default("NORMAL")
  isPinned     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("SUPERADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  adminEmail  String
  action      String
  description String
  createdAt   DateTime @default(now())
}
